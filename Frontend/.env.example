# Copia este archivo como .env y ajusta los valores para tu servidor.
# Las variables deben empezar por VITE_ para que Vite las exponga al navegador.

# URL base del backend (Node/Express). Hoy el prototipo usa datos locales,
# esta variable queda lista para cuando se conecte el API.
VITE_API_URL=http://localhost:3000/api

# Nombre que se muestra en la aplicación
VITE_APP_NAME=BikeStore
